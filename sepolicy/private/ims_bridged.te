type ims_bridged, domain, coredomain;
type ims_bridged_exec, system_file_type, exec_type, file_type;

init_daemon_domain(ims_bridged)

allow ims_bridged self:global_capability_class_set { net_admin net_raw };
allow ims_bridged self:netlink_generic_socket create_socket_perms_no_ioctl;
allow ims_bridged self:netlink_route_socket { create_socket_perms_no_ioctl nlmsg_read nlmsg_write };
allow ims_bridged self:rawip_socket { create getopt setopt };
allow ims_bridged self:udp_socket create_socket_perms;
allowxperm ims_bridged self:udp_socket ioctl { SIOCGIFINDEX SIOCETHTOOL };
allow ims_bridged kernel:system module_request;
allow ims_bridged proc_net:file rw_file_perms;
allow ims_bridged { shell_exec toolbox_exec }:file rx_file_perms;

allow ims_bridged { radio system_app }:dir search;
allow ims_bridged { radio system_app }:file r_file_perms;
allow ims_bridged { radio system_app }:fd use;
allow ims_bridged { radio system_app }:{ tcp_socket udp_socket } { read write getopt setopt };
allow { radio system_app } ims_bridged:unix_stream_socket connectto;
